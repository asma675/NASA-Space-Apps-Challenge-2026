# Copy to .env (Docker Compose reads .env automatically; for local run export vars yourself).
APP_ENV=development
BLINDSPOT_DB_PATH=/app/data/blindspot.sqlite3
# Required to fetch actual NASA records. Request a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Strong random token required in production. When set, imports require X-Admin-Token.
ADMIN_TOKEN=

# Optional: MapTiler PUBLIC BROWSER key for Dataviz Dark/Light, Satellite and Hybrid.
# This is deliberately sent to browsers; restrict allowed domains in MapTiler Cloud.
# Leave empty for free CARTO dark/light fallback basemaps.
MAPTILER_API_KEY=
